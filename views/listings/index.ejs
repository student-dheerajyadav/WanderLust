<% layout("/layouts/boilersPlate.ejs")   %>
<body>
    <h3>All Listings</h3>
    <!-- <form action="/listings/new" method="get">
        <button>Create new Listings</button>
    </form> -->

<div class="row row-cols-lg-3">
      <%for(let listing of allListings){%>

<a href="/listings/<%=listing._id%>" class="listing-links">

  <div class="card" >
  <img src="<%= typeof listing.image === 'object' ? listing.image.url : listing.image %>" 
       class="card-img-top" 
       alt="listing_image"
       style="height: 20rem;">
 <div class="card-img-overlay">abc</div>
  <div class="card-body">
    <h5 class="card-title"><b><%= listing.title %></b></h5>
    <p class="card-text">&#8377 <%= listing.price.toLocaleString("en-IN") %>/night</p>

  </div>
</div>
</a>

    <%}%>
</div>


</body>
