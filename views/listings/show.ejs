<% layout("/layouts/boilersPlate.ejs")   %>

<body>
    <h3>Listing Details :</h3>
    <ul>
        <li><%=list.title%></li>
        <li><%=list.description%></li>
        <li> &#8377 <%=list.price.toLocaleString("en-In")%></li>
        <li><%=list.location%></li>
        <li><%=list.country%></li>
        
    </ul>
    <a href="/listings/<%=list._id%>/edit">Edit this Listing</a>
    <br><br>
    <form method="post" action="/listings/<%=list._id%>?_method=Delete">
        <button>Delete this listings</button>
    </form>
    
</body>
