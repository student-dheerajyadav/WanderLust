<% layout("/layouts/boilersPlate.ejs")   %>

<body>
   <div class="row mt-3">
    <div class="col-8 offset-4  ">
 <h3>Listing Details </h3>

    <div class="card" style="width: 20rem;">
  <img src="<%=list.image.url%>" class="card-img-top" alt="listings_img">
  <div class="card-body">
    <h5 class="card-title"><b><%=list.title%></b></h5>
    <p class="card-text">
        <%=list.description%><br>
         &#8377 <%=list.price.toLocaleString("en-In")%><br>
         <%=list.location%><br>
         <%=list.country%>
    </p>
  </div>
</div>

</div>


 <div class="btns">
   <a href="/listings/<%=list._id%>/edit" class="btn btn-dark offset-4 edit-btn col-1">Edit</a>
   <br><br>
   <form method="post" action="/listings/<%=list._id%>?_method=Delete">
     <button class="btn btn-dark offset-5 " >Delete</button>
    </form>


 </div> 
   </div>
    
</body>
